# =============================================================================
# Kore Repuestos · Frontend Web (Vite)
# Copiar a .env.local — Vite expone variables prefijadas con VITE_ al cliente.
# =============================================================================

# URL base del backend NestJS (incluye el prefijo de versión).
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Clave pública VAPID para Web Push (ADR-0006). Debe coincidir con
# VAPID_PUBLIC_KEY del backend. Sin ella, el switch de notificaciones push
# permanece deshabilitado.
VITE_VAPID_PUBLIC_KEY=
